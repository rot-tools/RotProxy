{
  "schemaVersion": 1,
  "id": "rotproxy",
  "version": "${version}",
  "name": "RotProxy",
  "description": "Client-side Fabric proxy mod with proxy health checks, a kill switch, and a Multiplayer quick-config button.",
  "authors": [
    "OgRudolf / rot-tools"
  ],
  "contact": {
    "homepage": "https://github.com/rot-tools/RotProxy",
    "sources": "https://github.com/rot-tools/RotProxy",
    "issues": "https://github.com/rot-tools/RotProxy/issues"
  },
  "license": "MIT",
  "icon": "assets/rotproxy/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.rotproxy.RotProxyMod"
    ]
  },
  "mixins": [
    "rotproxy.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25"
  }
}
